# DSL Air-Cargo — Variables d'environnement (backend)
# Copier ce fichier en .env et renseigner les vraies valeurs. Ne jamais committer .env.

DATABASE_URL="postgresql://postgres:password@localhost:5432/dsl_air_cargo?schema=public"

PORT=4000
NODE_ENV=development

# Secrets JWT — générer des chaînes aléatoires longues en production
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# URL du frontend autorisée pour CORS
FRONTEND_URL="http://localhost:5173"

# OTP (connexion rapide WhatsApp/SMS)
OTP_EXPIRES_IN_MINUTES=5

# Green API (envoi WhatsApp réel — OTP + notifications client). Si absentes, les messages ne
# sont pas envoyés (le code OTP reste visible en console, mais seulement en NODE_ENV=development).
# Créer un compte sur green-api.com pour obtenir ces valeurs.
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
